        "import nltk\n",
        "from nltk.tokenize import word_tokenize\n",
        "from nltk.stem import PorterStemmer\n",
        "from nltk.corpus import stopwords # remember to import the stopwords\n",
        "nltk.download('punkt')\n",
        "nltk.download('punkt_tab')\n",
        "nltk.download('stopwords')  # remember to download stopwords\n",
        "\n",
        "text = \"I Love Solving real World Problems Using DSA Algorithms!\"\n",
        "\n",
        "sentences = nltk.sent_tokenize(text)\n",
        "stemmer = PorterStemmer()\n",
        "\n",
        "stop_words = set(stopwords.words('english'))  # remember to use set\n",
        "\n",
        "for sentence in sentences:\n",
        "   words = word_tokenize(text)\n",
        "   stemmed_words = [stemmer.stem(word) for word in words]\n",
        "   words = [word for word in words if word.lower() not in stop_words]  # remember to remove the stopwords by using loop\n",
        "   print(\"Original Text :\", text)\n",
        "   print(\"Before Removing StopWords :\", stop_words)\n",
        "   print(\"After Removing StopWords :\", words)\n",
        "   print(\"Before Tokenize :\", sentence)\n",
        "   print(\"After Tokenize :\", words)\n",
        "   print(stemmed_words)"
      ],
